          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": false,
        "expr": "changes(node_boot_time_seconds[2m]) > 0",
        "iconColor": "#5794F2",
        "name": "Deployments & incidents (example)",
        "titleFormat": "Deploy / incident",
        "type": "alert"
      }
